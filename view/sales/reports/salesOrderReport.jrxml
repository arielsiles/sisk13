<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="salesOrderReport" pageWidth="612" pageHeight="792" orientation="Portrait"
              whenNoDataType="AllSectionsNoDetail" columnWidth="532" leftMargin="40" rightMargin="40"
              topMargin="30" bottomMargin="30">

    <parameter name="P_number" class="java.lang.String"/>
    <parameter name="P_date" class="java.lang.String"/>
    <parameter name="P_deliveryDate" class="java.lang.String"/>
    <parameter name="P_state" class="java.lang.String"/>
    <parameter name="P_buyerName" class="java.lang.String"/>
    <parameter name="P_buyerReg" class="java.lang.String"/>
    <parameter name="P_buyerAddress" class="java.lang.String"/>
    <parameter name="P_buyerPhone" class="java.lang.String"/>
    <parameter name="P_buyerFax" class="java.lang.String"/>
    <parameter name="P_buyerEmail" class="java.lang.String"/>
    <parameter name="P_incoterm" class="java.lang.String"/>
    <parameter name="P_incotermPlace" class="java.lang.String"/>
    <parameter name="P_currency" class="java.lang.String"/>
    <parameter name="P_quotation" class="java.lang.String"/>
    <parameter name="P_scCode" class="java.lang.String"/>
    <parameter name="P_ccCode" class="java.lang.String"/>
    <parameter name="P_paymentConditions" class="java.lang.String"/>
    <parameter name="P_headerTerm" class="java.lang.String"/>
    <parameter name="P_comments" class="java.lang.String"/>
    <parameter name="P_subtotal" class="java.math.BigDecimal"/>
    <parameter name="P_discount" class="java.math.BigDecimal"/>
    <parameter name="P_recharge" class="java.math.BigDecimal"/>
    <parameter name="P_total" class="java.math.BigDecimal"/>
    <parameter name="P_notes" class="java.lang.String"/>

    <field name="col1" class="java.lang.Long"><fieldDescription><![CDATA[COLUMN_1]]></fieldDescription></field>
    <field name="col2" class="java.lang.String"><fieldDescription><![CDATA[COLUMN_2]]></fieldDescription></field>
    <field name="col3" class="java.lang.String"><fieldDescription><![CDATA[COLUMN_3]]></fieldDescription></field>
    <field name="col4" class="java.lang.String"><fieldDescription><![CDATA[COLUMN_4]]></fieldDescription></field>
    <field name="col5" class="java.math.BigDecimal"><fieldDescription><![CDATA[COLUMN_5]]></fieldDescription></field>
    <field name="col6" class="java.lang.String"><fieldDescription><![CDATA[COLUMN_6]]></fieldDescription></field>
    <field name="col7" class="java.math.BigDecimal"><fieldDescription><![CDATA[COLUMN_7]]></fieldDescription></field>
    <field name="col8" class="java.math.BigDecimal"><fieldDescription><![CDATA[COLUMN_8]]></fieldDescription></field>

    <title>
        <band height="240">
            <!-- ===== Franja superior: logo + contacto ===== -->
            <image scaleImage="RetainShape" onErrorType="Blank" hAlign="Left" vAlign="Middle">
                <reportElement x="0" y="0" width="90" height="52"/>
                <imageExpression class="java.io.InputStream"><![CDATA[com.encens.khipus.util.JSFUtil.getServletContext().getResourceAsStream("/img/logo-terdemol-v.jpg")]]></imageExpression>
            </image>
            <textField isStretchWithOverflow="true">
                <reportElement x="292" y="2" width="240" height="48"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="7" isItalic="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Phone: +591 72220798\nParque Industrial Santivanez\nCochabamba - Bolivia\nwww.terdemol.com"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="56" width="532" height="1"/>
                <graphicElement><pen lineWidth="1.0"/></graphicElement>
            </line>

            <!-- ===== Celda ORDER (izquierda, alta) ===== -->
            <textField>
                <reportElement x="0" y="62" width="118" height="170"/>
                <box><pen lineWidth="0.75"/></box>
                <textElement/>
                <textFieldExpression class="java.lang.String"><![CDATA[""]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="98" width="118" height="26"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="17" isBold="true"/></textElement>
                <text><![CDATA[ORDER]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="126" width="118" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="13" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["No: " + $P{P_number}]]></textFieldExpression>
            </textField>

            <!-- ===== Columna central: identidad del comprador ===== -->
            <textField isStretchWithOverflow="true">
                <reportElement x="118" y="62" width="207" height="28"/>
                <box leftPadding="3" topPadding="2"><pen lineWidth="0.5"/></box>
                <textElement markup="styled"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["<b>FECHA:</b>\n" + $P{P_date}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="118" y="90" width="207" height="30"/>
                <box leftPadding="3" topPadding="2"><pen lineWidth="0.5"/></box>
                <textElement markup="styled"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["<b>NUMERO DE REGISTRO:</b>\n" + $P{P_buyerReg}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="118" y="120" width="207" height="42"/>
                <box leftPadding="3" topPadding="2"><pen lineWidth="0.5"/></box>
                <textElement markup="styled"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["<b>DIRECCION:</b>\n" + $P{P_buyerAddress}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="118" y="162" width="104" height="24"/>
                <box leftPadding="3" topPadding="2"><pen lineWidth="0.5"/></box>
                <textElement markup="styled"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["<b>TELEFONO:</b>\n" + $P{P_buyerPhone}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="222" y="162" width="103" height="24"/>
                <box leftPadding="3" topPadding="2"><pen lineWidth="0.5"/></box>
                <textElement markup="styled"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["<b>FAX:</b>\n" + $P{P_buyerFax}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="118" y="186" width="207" height="22"/>
                <box leftPadding="3" topPadding="2"><pen lineWidth="0.5"/></box>
                <textElement markup="styled"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["<b>E-Mail:</b>  " + $P{P_buyerEmail}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="118" y="208" width="207" height="24"/>
                <box leftPadding="3" topPadding="2"><pen lineWidth="0.5"/></box>
                <textElement><font fontName="Arial" size="6"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{P_headerTerm}]]></textFieldExpression>
            </textField>

            <!-- ===== Columna derecha: comprador / condiciones ===== -->
            <textField isStretchWithOverflow="true">
                <reportElement x="325" y="62" width="207" height="52"/>
                <box leftPadding="3" topPadding="2"><pen lineWidth="0.5"/></box>
                <textElement markup="styled"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["<b>COMPRADOR:</b>\n" + $P{P_buyerName}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="325" y="114" width="207" height="46"/>
                <box leftPadding="3" topPadding="2"><pen lineWidth="0.5"/></box>
                <textElement markup="styled"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["<b>CONDICIONES DE PAGO:</b>\n" + $P{P_paymentConditions}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="325" y="160" width="207" height="26"/>
                <box leftPadding="3" topPadding="2"><pen lineWidth="0.5"/></box>
                <textElement markup="styled"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["<b>FECHA DE ENTREGA:</b>\n" + $P{P_deliveryDate}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="325" y="186" width="207" height="46"/>
                <box leftPadding="3" topPadding="2"><pen lineWidth="0.5"/></box>
                <textElement markup="styled"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["<b>INCOTERM:</b>\n     " + $P{P_incoterm} + " " + $P{P_incotermPlace}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement x="0" y="0" width="30" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="7" isBold="true"/></textElement>
                <text><![CDATA[ITEM]]></text>
            </staticText>
            <staticText>
                <reportElement x="30" y="0" width="60" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="7" isBold="true"/></textElement>
                <text><![CDATA[CODE]]></text>
            </staticText>
            <staticText>
                <reportElement x="90" y="0" width="55" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="7" isBold="true"/></textElement>
                <text><![CDATA[COST CENTER]]></text>
            </staticText>
            <staticText>
                <reportElement x="145" y="0" width="180" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="7" isBold="true"/></textElement>
                <text><![CDATA[DESCRIPTION]]></text>
            </staticText>
            <staticText>
                <reportElement x="325" y="0" width="55" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="7" isBold="true"/></textElement>
                <text><![CDATA[QUANTITY]]></text>
            </staticText>
            <staticText>
                <reportElement x="380" y="0" width="45" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="7" isBold="true"/></textElement>
                <text><![CDATA[MEASURE]]></text>
            </staticText>
            <staticText>
                <reportElement x="425" y="0" width="55" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="7" isBold="true"/></textElement>
                <text><![CDATA[UNIT PRICE]]></text>
            </staticText>
            <staticText>
                <reportElement x="480" y="0" width="52" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="7" isBold="true"/></textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="26">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="30" height="26"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.Long"><![CDATA[$F{col1}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="30" y="0" width="60" height="26"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{col2}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="90" y="0" width="55" height="26"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{col3}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="145" y="0" width="180" height="26"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{col4}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" pattern="#,##0.00">
                <reportElement x="325" y="0" width="55" height="26"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{col5}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="380" y="0" width="45" height="26"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{col6}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" pattern="#,##0.00">
                <reportElement x="425" y="0" width="55" height="26"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{col7}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" pattern="#,##0.00">
                <reportElement x="480" y="0" width="52" height="26"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{col8}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="230">
            <!-- ===== COMMENTS (izquierda) ===== -->
            <staticText>
                <reportElement x="0" y="6" width="200" height="12"/>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <text><![CDATA[COMMENTS:]]></text>
            </staticText>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="20" width="315" height="48"/>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{P_comments}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="72" width="315" height="12"/>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Incoterm: " + $P{P_incoterm} + " " + $P{P_incotermPlace}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="90" width="315" height="14"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["COTIZACION: " + $P{P_quotation}]]></textFieldExpression>
            </textField>

            <!-- ===== Totales (derecha, bordeado) ===== -->
            <staticText>
                <reportElement x="325" y="0" width="120" height="16"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <text><![CDATA[Sub Total]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="445" y="0" width="87" height="16"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{P_subtotal}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="325" y="16" width="120" height="16"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <text><![CDATA[Discount]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="445" y="16" width="87" height="16"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{P_discount}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="325" y="32" width="120" height="16"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <text><![CDATA[Recharge]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="445" y="32" width="87" height="16"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{P_recharge}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="325" y="48" width="120" height="18"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Total]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="445" y="48" width="87" height="18"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{P_currency} + " " + new java.text.DecimalFormat("#,##0.00").format($P{P_total} == null ? java.math.BigDecimal.ZERO : $P{P_total})]]></textFieldExpression>
            </textField>

            <!-- ===== S/C | C/C (bordeado, ancho completo) ===== -->
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="112" width="266" height="16"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle" markup="styled"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["<b>S/C :</b>  " + $P{P_scCode}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="266" y="112" width="266" height="16"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle" markup="styled"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["<b>C/C :</b>  " + $P{P_ccCode}]]></textFieldExpression>
            </textField>

            <!-- ===== NOTAS (pie) ===== -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="134" width="532" height="80"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{P_notes}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
