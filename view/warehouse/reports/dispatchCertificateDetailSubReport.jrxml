<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="DispatchCertificateDetailSubReport"
              pageWidth="562" pageHeight="792"
              whenNoDataType="AllSectionsNoDetail"
              columnWidth="562"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
    <field name="detail.quantity" class="java.math.BigDecimal">
        <fieldDescription><![CDATA[COLUMN_1]]></fieldDescription>
    </field>
    <field name="detail.measureUnit" class="java.lang.String">
        <fieldDescription><![CDATA[COLUMN_2]]></fieldDescription>
    </field>
    <field name="detail.productItem" class="java.lang.String">
        <fieldDescription><![CDATA[COLUMN_3]]></fieldDescription>
    </field>
    <field name="detail.bagsCount" class="java.lang.Integer">
        <fieldDescription><![CDATA[COLUMN_4]]></fieldDescription>
    </field>
    <field name="detail.observation" class="java.lang.String">
        <fieldDescription><![CDATA[COLUMN_5]]></fieldDescription>
    </field>
    <columnHeader>
        <band height="16">
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement mode="Opaque" x="0" y="0" width="60" height="16" backcolor="#DDDDDD"/>
                <box padding="2"><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Center"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["CANTIDAD"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement mode="Opaque" x="60" y="0" width="60" height="16" backcolor="#DDDDDD"/>
                <box padding="2"><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Center"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["UNIDAD"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement mode="Opaque" x="120" y="0" width="220" height="16" backcolor="#DDDDDD"/>
                <box padding="2"><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Center"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["PRODUCTO / SERVICIO"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement mode="Opaque" x="340" y="0" width="80" height="16" backcolor="#DDDDDD"/>
                <box padding="2"><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Center"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["BOLSAS"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement mode="Opaque" x="420" y="0" width="142" height="16" backcolor="#DDDDDD"/>
                <box padding="2"><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Center"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["DESCRIPCION DETALLADA"]]></textFieldExpression>
            </textField>
        </band>
    </columnHeader>
    <detail>
        <band height="20">
            <textField isStretchWithOverflow="true" pattern="#,##0.###" isBlankWhenNull="true">
                <reportElement positionType="Float" stretchType="RelativeToTallestObject" x="0" y="0" width="60" height="20"/>
                <box padding="2"><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Right"><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{detail.quantity}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement positionType="Float" stretchType="RelativeToTallestObject" x="60" y="0" width="60" height="20"/>
                <box padding="2"><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Center"><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{detail.measureUnit}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement positionType="Float" stretchType="RelativeToTallestObject" x="120" y="0" width="220" height="20"/>
                <box padding="2"><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Left"><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{detail.productItem}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement positionType="Float" stretchType="RelativeToTallestObject" x="340" y="0" width="80" height="20"/>
                <box padding="2"><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Center"><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression class="java.lang.Integer"><![CDATA[$F{detail.bagsCount}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement positionType="Float" stretchType="RelativeToTallestObject" x="420" y="0" width="142" height="20"/>
                <box padding="2"><pen lineWidth="0.5" lineColor="#000000"/></box>
                <textElement textAlignment="Left"><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{detail.observation}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
