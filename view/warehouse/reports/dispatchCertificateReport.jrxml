<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="DispatchCertificateReport"
              pageWidth="612" pageHeight="792"
              whenNoDataType="AllSectionsNoDetail"
              columnWidth="532"
              leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40">

    <parameter name="companyName" class="java.lang.String"/>
    <parameter name="locationName" class="java.lang.String"/>
    <parameter name="deliveryOrderNumber" class="java.lang.Long"/>
    <parameter name="dispatchDate" class="java.util.Date"/>
    <parameter name="dispatchTime" class="java.util.Date"/>
    <parameter name="sellerName" class="java.lang.String"/>
    <parameter name="sellerCi" class="java.lang.String"/>
    <parameter name="sellerCharge" class="java.lang.String"/>
    <parameter name="sellerPhone" class="java.lang.String"/>
    <parameter name="salesLotCode" class="java.lang.String"/>
    <parameter name="bagCount" class="java.lang.Integer"/>
    <parameter name="invoiceNumber" class="java.lang.String"/>
    <parameter name="clientName" class="java.lang.String"/>
    <parameter name="clientCode" class="java.lang.String"/>
    <parameter name="transportCompany" class="java.lang.String"/>
    <parameter name="driverName" class="java.lang.String"/>
    <parameter name="driverLicense" class="java.lang.String"/>
    <parameter name="driverPhone" class="java.lang.String"/>
    <parameter name="vehiclePlate" class="java.lang.String"/>
    <parameter name="vehicleBrand" class="java.lang.String"/>
    <parameter name="vehicleColor" class="java.lang.String"/>
    <parameter name="loadingStart" class="java.lang.String"/>
    <parameter name="loadingEnd" class="java.lang.String"/>
    <parameter name="truckDispatchNumber" class="java.lang.Integer"/>
    <parameter name="weighingTicket" class="java.lang.String"/>
    <parameter name="tareWeight" class="java.math.BigDecimal"/>
    <parameter name="grossWeight" class="java.math.BigDecimal"/>
    <parameter name="netWeight" class="java.math.BigDecimal"/>
    <parameter name="netWeightTons" class="java.math.BigDecimal"/>
    <parameter name="bagsFromNumber" class="java.lang.Integer"/>
    <parameter name="bagsToNumber" class="java.lang.Integer"/>
    <parameter name="originPlace" class="java.lang.String"/>
    <parameter name="destinationPlace" class="java.lang.String"/>
    <parameter name="warehouseResponsible" class="java.lang.String"/>
    <parameter name="warehouseResponsibleCi" class="java.lang.String"/>
    <parameter name="productionTurn" class="java.lang.String"/>
    <parameter name="productListDescription" class="java.lang.String"/>
    <parameter name="state" class="java.lang.String"/>
    <parameter name="annulled" class="java.lang.Boolean"/>
    <parameter name="DETAILSUBREPORT" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="DETAILSUBREPORT_DATASOURCE" class="net.sf.jasperreports.engine.JRDataSource"/>

    <title>
        <band height="120">
            <!-- ============ ENCABEZADO: logo + titulo + empresa/orden ============ -->
            <!-- Celda izquierda: logo TERDEMOL (mas angosta) -->
            <image scaleImage="RetainShape" onErrorType="Blank" hAlign="Center" vAlign="Middle">
                <reportElement x="0" y="0" width="85" height="56"/>
                <box><pen lineWidth="0.5"/></box>
                <imageExpression class="java.io.InputStream"><![CDATA[com.encens.khipus.util.JSFUtil.getServletContext().getResourceAsStream("/img/logo-terdemol-v.jpg")]]></imageExpression>
            </image>

            <!-- Celda centro: REGISTRO / CERTIFICADO (mas ancha) -->
            <textField isStretchWithOverflow="true">
                <reportElement x="85" y="0" width="357" height="18"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["REGISTRO"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="85" y="18" width="357" height="38"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="11" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["CERTIFICADO DE RECEPCION DE CARGUIO"]]></textFieldExpression>
            </textField>

            <!-- Celda derecha: empresa + orden (mas angosta) -->
            <textField isStretchWithOverflow="true">
                <reportElement x="442" y="0" width="90" height="26"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="7" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["TERDEMOL S.R.L.\nTERMINAL DE\nMOLIENDA"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="442" y="26" width="90" height="18"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="7" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["ORDEN DE\nENTREGA N°"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="442" y="44" width="90" height="12"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{deliveryOrderNumber} != null ? String.format("%06d", $P{deliveryOrderNumber}) : "-"]]></textFieldExpression>
            </textField>

            <!-- ============ Datos empresa (izq) + Vendedor (der) ============ -->
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="56" width="287" height="64"/>
                <box leftPadding="4"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Direccion de la Empresa: Parque Industrial Santivanez - Avenida V.\nTelefono: 4016168 - Cel.: 72220798\nCorreo Electronico: ventas@terdemol.com\nSitio Web: www.terdemol.com"]]></textFieldExpression>
            </textField>

            <textField isStretchWithOverflow="true">
                <reportElement x="287" y="56" width="245" height="12"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["DATOS DE VENDEDOR DE ENTREGA"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="287" y="68" width="245" height="13"/>
                <box leftPadding="4"><pen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Nombre: " + ($P{sellerName} != null ? $P{sellerName} : "")]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="287" y="81" width="245" height="13"/>
                <box leftPadding="4"><pen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["C.I.: " + ($P{sellerCi} != null ? $P{sellerCi} : "")]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="287" y="94" width="245" height="13"/>
                <box leftPadding="4"><pen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Cargo: " + ($P{sellerCharge} != null ? $P{sellerCharge} : "")]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="287" y="107" width="245" height="13"/>
                <box leftPadding="4"><pen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Celular: " + ($P{sellerPhone} != null ? $P{sellerPhone} : "")]]></textFieldExpression>
            </textField>

        </band>
    </title>

    <pageFooter>
        <band height="14">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="266" height="12"/>
                <textElement><font fontName="Arial" size="7"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Estado: " + ($P{state} != null ? $P{state} : "")]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="266" y="0" width="266" height="12"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="7"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Pagina " + $V{PAGE_NUMBER} + " de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>


    <summary>
        <band height="435">
            <!-- Watermark ANULADO (sobre la zona de productos) -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="106" y="120" width="320" height="80" forecolor="#FF0000">
                    <printWhenExpression><![CDATA[Boolean.TRUE.equals($P{annulled})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" rotation="None">
                    <font fontName="Arial" size="60" isBold="true"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["ANULADO"]]></textFieldExpression>
            </textField>

            <!-- Tabla 2: Datos del despacho (7 filas, como la imagen) -->

            <!-- Fila 1: PLANTA DE DESPACHO | No. de orden -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="0" width="138" height="13"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["PLANTA DE DESPACHO"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="138" y="0" width="244" height="13"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{originPlace}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="382" y="0" width="85" height="13"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["No. de orden"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="467" y="0" width="65" height="13"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{deliveryOrderNumber} != null ? String.format("%06d", $P{deliveryOrderNumber}) : "-"]]></textFieldExpression>
            </textField>

            <!-- Fila 2: PRODUCTO (un renglon por producto) | Fecha -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="13" width="138" height="13"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["PRODUCTO"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="138" y="13" width="244" height="13"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{productListDescription}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="382" y="13" width="85" height="13"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Fecha"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" pattern="dd/MM/yyyy" isBlankWhenNull="true">
                <reportElement x="467" y="13" width="65" height="13"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.util.Date"><![CDATA[$P{dispatchDate}]]></textFieldExpression>
            </textField>

            <!-- Fila 3: DESTINO | Hora entrega (Float: se desplaza si PRODUCTO crece) -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="26" width="138" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["DESTINO"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="138" y="26" width="244" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{destinationPlace}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="382" y="26" width="85" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Hora entrega"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="467" y="26" width="65" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{loadingEnd}]]></textFieldExpression>
            </textField>

            <!-- Fila 4: CLIENTE / TRANSBORDO | N de Lote -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="39" width="138" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["CLIENTE / TRANSBORDO"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="138" y="39" width="244" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{clientCode}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="382" y="39" width="85" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["N° de Lote"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="467" y="39" width="65" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{salesLotCode}]]></textFieldExpression>
            </textField>

            <!-- Fila 5: NOMBRE CONDUCTOR | PLACA CAMION -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="52" width="138" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["NOMBRE CONDUCTOR"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="138" y="52" width="244" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{driverName}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="382" y="52" width="85" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["PLACA CAMION"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="467" y="52" width="65" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{vehiclePlate}]]></textFieldExpression>
            </textField>

            <!-- Fila 6: CEDULA DE IDENTIDAD | COLOR CAMION -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="65" width="138" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["CEDULA DE IDENTIDAD"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="138" y="65" width="244" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{driverLicense}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="382" y="65" width="85" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["COLOR CAMION"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="467" y="65" width="65" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{vehicleColor}]]></textFieldExpression>
            </textField>

            <!-- Fila 7: EMPRESA DE TRANSPORTE | MARCA CAMION -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="78" width="138" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["EMPRESA DE TRANSPORTE"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="138" y="78" width="244" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{transportCompany}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="382" y="78" width="85" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["MARCA CAMION"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="467" y="78" width="65" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{vehicleBrand}]]></textFieldExpression>
            </textField>

            <!-- Subreport: detalle de productos (pegado a la tabla de despacho, sin separacion) -->
            <subreport runToBottom="false">
                <reportElement x="0" y="91" width="532" height="48" positionType="Float"/>
                <subreportParameter name="REPORT_RESOURCE_BUNDLE">
                    <subreportParameterExpression><![CDATA[$P{REPORT_RESOURCE_BUNDLE}]]></subreportParameterExpression>
                </subreportParameter>
                <dataSourceExpression><![CDATA[$P{DETAILSUBREPORT_DATASOURCE}]]></dataSourceExpression>
                <subreportExpression class="net.sf.jasperreports.engine.JasperReport"><![CDATA[$P{DETAILSUBREPORT}]]></subreportExpression>
            </subreport>

            <!-- Bloque MEDIDOR DE PESO (pegado al subreport, sin separacion) -->
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="139" width="128" height="78" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["MEDIDOR DE PESO"]]></textFieldExpression>
            </textField>

            <!-- TARA -->
            <textField isStretchWithOverflow="true">
                <reportElement x="128" y="139" width="138" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["TARA"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" pattern="#,##0.###" isBlankWhenNull="true">
                <reportElement x="266" y="139" width="128" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{tareWeight}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="394" y="139" width="138" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Kilogramos"]]></textFieldExpression>
            </textField>

            <!-- BRUTO -->
            <textField isStretchWithOverflow="true">
                <reportElement x="128" y="152" width="138" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["BRUTO"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" pattern="#,##0.###" isBlankWhenNull="true">
                <reportElement x="266" y="152" width="128" height="13" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement textAlignment="Center"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{grossWeight}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
