            <!-- Disclaimer (cuadro IMPORTANTE, pegado al recuadro de firma) -->
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="352" width="532" height="80" positionType="Float"/>
                <box padding="2"><pen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Middle" markup="styled"><font fontName="Arial" size="7"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["<b>IMPORTANTE:</b> Senor transportista, usted se responsabiliza del transporte de la totalidad de los sacos con productos para llevarlos al destino final, comprometiendose a llegar en un plazo no mayor de 3 DIAS al lugar para la entrega de la mercancia. EL TRANSPORTISTA respondera ante las instancias correspondientes por cualquier problema que se presente en la carga, como sustitucion de la misma, agio, violacion de precintos, entre otros. EL TRANSPORTISTA sera responsable de la mercancia desde que inicie el carguio en su vehiculo durante el viaje, hasta la recepcion de la mercaderia por parte del destinatario sin reclamacion, conforme al articulo 956 del codigo de transporte."]]></textFieldExpression>
