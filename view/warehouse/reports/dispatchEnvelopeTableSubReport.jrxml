<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="DispatchEnvelopeTableSubReport"
              pageWidth="532" pageHeight="752"
              whenNoDataType="AllSectionsNoDetail"
              columnWidth="532"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">

    <field name="identificationCode" class="java.lang.String"/>
    <field name="envelopeDetail" class="java.lang.String"/>
    <field name="netWeightApproxKg" class="java.math.BigDecimal"/>

    <columnHeader>
        <band height="18">
            <staticText>
                <reportElement x="0" y="0" width="90" height="18"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="6" isBold="true"/></textElement>
                <text><![CDATA[CODIGO DE IDENTIFICACION DE ENVASE]]></text>
            </staticText>
            <staticText>
                <reportElement x="90" y="0" width="362" height="18"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="6" isBold="true"/></textElement>
                <text><![CDATA[DETALLE DE ENVASE]]></text>
            </staticText>
            <staticText>
                <reportElement x="452" y="0" width="80" height="18"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="6" isBold="true"/></textElement>
                <text><![CDATA[PESO NETO APROX. (Kg.)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="10">
            <textField isStretchWithOverflow="false" isBlankWhenNull="true">
                <reportElement x="0" y="0" width="90" height="10"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="6"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{identificationCode}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="false" isBlankWhenNull="true">
                <reportElement x="90" y="0" width="362" height="10"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="6"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{envelopeDetail}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="false" isBlankWhenNull="true" pattern="#,##0.00">
                <reportElement x="452" y="0" width="80" height="10"/>
                <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="6"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{netWeightApproxKg}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>
