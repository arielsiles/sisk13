<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="DispatchRouteSheetCargoSubReport"
              pageWidth="532" pageHeight="792"
              whenNoDataType="AllSectionsNoDetail"
              columnWidth="532"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">

    <field name="description" class="java.lang.String"/>
    <field name="quantity" class="java.math.BigDecimal"/>
    <field name="unit" class="java.lang.String"/>

    <detail>
        <band height="50">
            <!-- DESCRIPCION label (col izquierda) -->
            <staticText>
                <reportElement x="0" y="0" width="100" height="50"/>
                <box leftPadding="4"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <text><![CDATA[DESCRIPCION:]]></text>
            </staticText>

            <!-- DESCRIPCION valor (texto largo del producto) -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="100" y="0" width="320" height="50"/>
                <box leftPadding="4" rightPadding="4" topPadding="2" bottomPadding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="7"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{description}]]></textFieldExpression>
            </textField>

            <!-- CANTIDAD label + valor (mitad superior columna derecha) -->
            <staticText>
                <reportElement x="420" y="0" width="55" height="25"/>
                <box leftPadding="4"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <text><![CDATA[CANTIDAD:]]></text>
            </staticText>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true" pattern="#,##0.##">
                <reportElement x="475" y="0" width="57" height="25"/>
                <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>

            <!-- UNIDAD label + valor (mitad inferior columna derecha) -->
            <staticText>
                <reportElement x="420" y="25" width="55" height="25"/>
                <box leftPadding="4"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <text><![CDATA[UNIDAD:]]></text>
            </staticText>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="475" y="25" width="57" height="25"/>
                <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{unit}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>
