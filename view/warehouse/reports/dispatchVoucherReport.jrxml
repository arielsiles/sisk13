<?xml version="1.0" encoding="UTF-8"?>
<!--
  Listado de Despachos de Productos Terminados (export Excel).

  El encabezado replica el formato solicitado: una sola fila de titulos, salvo
  "DATOS VEHICULO" que es una celda combinada sobre PLACA y COLOR. Para lograr
  la combinacion en XLSX, los titulos simples ocupan las dos filas (y=0, h=28) y
  los de vehiculo se parten en dos niveles (h=14 + h=14).

  El grupo "dispatchHeaderGroup" no tiene groupExpression: su groupHeader se
  imprime una sola vez al inicio, de modo que en el Excel no se repite la
  cabecera por pagina.

  Las celdas del detalle usan isStretchWithOverflow + stretchType
  "RelativeToTallestObject": el texto nunca se corta y el alto de la fila crece
  hasta el contenido mas largo (todas las celdas de la fila acompanan ese alto,
  para que la grilla no quede partida).
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="dispatchVoucherReport" pageWidth="1338" pageHeight="612" orientation="Landscape"
              whenNoDataType="AllSectionsNoDetail" columnWidth="1316"
              leftMargin="11" rightMargin="11" topMargin="11" bottomMargin="11">
	<field name="dispatchDate" class="java.util.Date">
		<fieldDescription><![CDATA[COLUMN_1]]></fieldDescription>
	</field>
	<field name="salesLotCode" class="java.lang.String">
		<fieldDescription><![CDATA[COLUMN_2]]></fieldDescription>
	</field>
	<field name="invoiceNumber" class="java.lang.String">
		<fieldDescription><![CDATA[COLUMN_3]]></fieldDescription>
	</field>
	<field name="transportCompany" class="java.lang.String">
		<fieldDescription><![CDATA[COLUMN_4]]></fieldDescription>
	</field>
	<field name="truckNumber" class="java.lang.Integer">
		<fieldDescription><![CDATA[COLUMN_5]]></fieldDescription>
	</field>
	<field name="driverName" class="java.lang.String">
		<fieldDescription><![CDATA[COLUMN_6]]></fieldDescription>
	</field>
	<field name="driverLicense" class="java.lang.String">
		<fieldDescription><![CDATA[COLUMN_7]]></fieldDescription>
	</field>
	<field name="driverPhone" class="java.lang.String">
		<fieldDescription><![CDATA[COLUMN_8]]></fieldDescription>
	</field>
	<field name="bagCount" class="java.lang.Long">
		<fieldDescription><![CDATA[COLUMN_9]]></fieldDescription>
	</field>
	<field name="plate" class="java.lang.String">
		<fieldDescription><![CDATA[COLUMN_10]]></fieldDescription>
	</field>
	<field name="color" class="java.lang.String">
		<fieldDescription><![CDATA[COLUMN_11]]></fieldDescription>
	</field>
	<field name="weighingTicket" class="java.lang.String">
		<fieldDescription><![CDATA[COLUMN_12]]></fieldDescription>
	</field>
	<field name="state" class="com.encens.khipus.model.warehouse.DispatchState">
		<fieldDescription><![CDATA[COLUMN_13]]></fieldDescription>
	</field>
	<group name="dispatchHeaderGroup">
		<groupHeader>
			<band height="28">
				<textField>
					<reportElement mode="Opaque" x="0" y="0" width="60" height="28" backcolor="#D9D9D9"/>
					<box><pen lineWidth="0.5"/><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font fontName="Arial" size="8" isBold="true"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$R{WarehouseDispatch.report.date}]]></textFieldExpression>
