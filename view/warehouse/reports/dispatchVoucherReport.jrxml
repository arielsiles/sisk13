				<reportElement stretchType="RelativeToTallestObject" x="60" y="0" width="85" height="14"/>
				<box><pen lineWidth="0.5"/><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
