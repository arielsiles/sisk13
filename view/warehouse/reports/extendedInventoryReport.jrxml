<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="extendedInventoryReport" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="792" leftMargin="25" rightMargin="25" topMargin="19" bottomMargin="19">
    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="startDate" class="java.util.Date"/>
    <parameter name="endDate" class="java.util.Date"/>
    <parameter name="warehouse" class="java.lang.String"/>
    <parameter name="companyName" class="java.lang.String"/>
    <parameter name="locationName" class="java.lang.String"/>
    <parameter name="systemName" class="java.lang.String"/>
    <field name="articleCode" class="java.lang.String"/>
    <field name="articleName" class="java.lang.String"/>
    <field name="unit" class="java.lang.String"/>
    <field name="subgroupName" class="java.lang.String"/>
    <field name="initialBalance" class="java.math.BigDecimal"/>
    <field name="date" class="java.util.Date"/>
    <field name="entryAmount" class="java.math.BigDecimal"/>
    <field name="outputAmount" class="java.math.BigDecimal"/>
    <field name="balance" class="java.math.BigDecimal"/>
    <field name="description" class="java.lang.String"/>
    <variable name="totalEntry" class="java.math.BigDecimal" resetType="Group" resetGroup="articleGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{entryAmount}]]></variableExpression>
    </variable>
    <variable name="totalOutput" class="java.math.BigDecimal" resetType="Group" resetGroup="articleGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{outputAmount}]]></variableExpression>
    </variable>
    <variable name="grandTotalEntry" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{entryAmount}]]></variableExpression>
    </variable>
    <variable name="grandTotalOutput" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{outputAmount}]]></variableExpression>
    </variable>
    <group name="articleGroup" isStartNewPage="false" isReprintHeaderOnEachPage="true">
        <groupExpression><![CDATA[$F{articleCode}]]></groupExpression>
        <groupHeader>
            <band height="30">
                <textField>
                    <reportElement x="0" y="0" width="60" height="15"/>
                    <textElement><font size="8" isBold="true"/></textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[$F{articleCode}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="62" y="0" width="280" height="15"/>
                    <textElement><font size="8" isBold="true"/></textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[$F{articleName}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="344" y="0" width="40" height="15"/>
                    <textElement><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Unidad:]]></text>
                </staticText>
                <textField>
                    <reportElement x="386" y="0" width="60" height="15"/>
                    <textElement><font size="7"/></textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[$F{unit}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="450" y="0" width="60" height="15"/>
                    <textElement><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Inv. Inicial:]]></text>
                </staticText>
                <textField pattern="#,##0.00">
                    <reportElement x="512" y="0" width="80" height="15"/>
                    <textElement textAlignment="Right"><font size="7" isBold="true"/></textElement>
                    <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{initialBalance}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="600" y="0" width="55" height="15"/>
                    <textElement><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Subgrupo:]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement x="657" y="0" width="135" height="15"/>
                    <textElement><font size="7"/></textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[$F{subgroupName}]]></textFieldExpression>
                </textField>
                <!-- Column headers -->
                <staticText>
                    <reportElement mode="Opaque" x="0" y="16" width="70" height="12" backcolor="#DDDDDD"/>
                    <textElement><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Fecha]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="72" y="16" width="80" height="12" backcolor="#DDDDDD"/>
                    <textElement textAlignment="Right"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Entrada]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="154" y="16" width="80" height="12" backcolor="#DDDDDD"/>
                    <textElement textAlignment="Right"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Salida]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="236" y="16" width="80" height="12" backcolor="#DDDDDD"/>
                    <textElement textAlignment="Right"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Saldo]]></text>
                </staticText>
                <staticText>
                    <reportElement mode="Opaque" x="318" y="16" width="474" height="12" backcolor="#DDDDDD"/>
                    <textElement><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Glosa]]></text>
                </staticText>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="16">
                <staticText>
                    <reportElement x="0" y="1" width="70" height="12"/>
                    <textElement><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Subtotal]]></text>
                </staticText>
                <textField pattern="#,##0.00">
                    <reportElement x="72" y="1" width="80" height="12"/>
                    <textElement textAlignment="Right"><font size="7" isBold="true"/></textElement>
                    <textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{totalEntry}]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0.00">
                    <reportElement x="154" y="1" width="80" height="12"/>
                    <textElement textAlignment="Right"><font size="7" isBold="true"/></textElement>
                    <textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{totalOutput}]]></textFieldExpression>
                </textField>
                <line>
                    <reportElement x="0" y="0" width="792" height="1"/>
                </line>
            </band>
        </groupFooter>
    </group>
    <title>
        <band height="60">
            <textField>
                <reportElement x="0" y="0" width="792" height="14"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{companyName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="14" width="792" height="12"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{locationName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="26" width="792" height="14"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="40" width="400" height="12"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Almacen: " + $P{warehouse}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy">
                <reportElement x="400" y="40" width="200" height="12"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Del " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{startDate}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{endDate})]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <detail>
        <band height="10">
            <textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
                <reportElement x="0" y="0" width="70" height="9"/>
                <textElement><font size="6"/></textElement>
                <textFieldExpression class="java.util.Date"><![CDATA[$F{date}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="72" y="0" width="80" height="9"/>
                <textElement textAlignment="Right"><font size="6"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{entryAmount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="154" y="0" width="80" height="9"/>
                <textElement textAlignment="Right"><font size="6"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{outputAmount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="236" y="0" width="80" height="9"/>
                <textElement textAlignment="Right"><font size="6"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{balance}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="318" y="0" width="474" height="9"/>
                <textElement><font size="6"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    <summary>
        <band height="20">
            <line>
                <reportElement x="0" y="0" width="792" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="2" width="70" height="14"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[TOTAL GENERAL]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="72" y="2" width="80" height="14"/>
                <textElement textAlignment="Right"><font size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{grandTotalEntry}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="154" y="2" width="80" height="14"/>
                <textElement textAlignment="Right"><font size="8" isBold="true"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{grandTotalOutput}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
    <pageFooter>
        <band height="14">
            <textField>
                <reportElement x="672" y="0" width="80" height="12"/>
                <textElement textAlignment="Right"><font size="6"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Pag. " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="752" y="0" width="40" height="12"/>
                <textElement><font size="6"/></textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
