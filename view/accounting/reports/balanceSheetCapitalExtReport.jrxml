<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ReportTemplate" pageWidth="288" pageHeight="432" whenNoDataType="AllSectionsNoDetail" columnWidth="288" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="3.138428376721004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="profitOrLoss" class="java.math.BigDecimal"/>
	<parameter name="totalLiabilities" class="java.math.BigDecimal"/>
	<field name="rootAccount" class="java.lang.String">
		<fieldDescription><![CDATA[COLUMN_1]]></fieldDescription>
	</field>
	<field name="rootNameAccount" class="java.lang.String">
		<fieldDescription><![CDATA[COLUMN_2]]></fieldDescription>
	</field>
	<field name="account" class="java.lang.String">
		<fieldDescription><![CDATA[COLUMN_3]]></fieldDescription>
	</field>
	<field name="nameAccount" class="java.lang.String">
		<fieldDescription><![CDATA[COLUMN_4]]></fieldDescription>
	</field>
	<field name="debit" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[COLUMN_5]]></fieldDescription>
	</field>
	<field name="credit" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[COLUMN_6]]></fieldDescription>
	</field>
	<variable name="creditBalance" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{credit}.subtract($F{debit})]]></variableExpression>
	</variable>
	<variable name="totalCreditBalance" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{creditBalance}]]></variableExpression>
		<initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="totalCapital" class="java.math.BigDecimal">
		<variableExpression><![CDATA[($V{totalCreditBalance} != null ? $V{totalCreditBalance} : java.math.BigDecimal.ZERO).add($P{profitOrLoss} != null ? $P{profitOrLoss} : java.math.BigDecimal.ZERO)]]></variableExpression>
	</variable>
	<variable name="totalPasivoPatrimonio" class="java.math.BigDecimal">
		<variableExpression><![CDATA[($P{totalLiabilities} != null ? $P{totalLiabilities} : java.math.BigDecimal.ZERO).add($V{totalCapital} != null ? $V{totalCapital} : java.math.BigDecimal.ZERO)]]></variableExpression>
		<initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<group name="GroupRoot">
		<groupExpression><![CDATA[$F{rootAccount}]]></groupExpression>
		<groupHeader>
			<band height="14">
				<textField isBlankWhenNull="true">
					<reportElement mode="Opaque" x="0" y="4" width="260" height="10" backcolor="#CCCCCC"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Arial" size="7" isBold="true"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{rootNameAccount}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
	</group>
	<title>
		<band height="11">
			<staticText>
				<reportElement x="0" y="0" width="99" height="11"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="9" isUnderline="true"/>
				</textElement>
				<text><![CDATA[- P A T R I M O N I O -]]></text>
			</staticText>
		</band>
	</title>
	<pageHeader>
		<band/>
	</pageHeader>
	<detail>
		<band height="10">
			<textField>
				<reportElement x="0" y="0" width="200" height="10"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{nameAccount}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;(#,##0.00)">
				<reportElement x="200" y="0" width="60" height="10"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{creditBalance}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band/>
	</columnFooter>
	<pageFooter>
		<band/>
	</pageFooter>
	<summary>
		<band height="39">
			<line>
				<reportElement x="200" y="9" width="60" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5" lineStyle="Solid"/>
				</graphicElement>
			</line>
			<textField pattern="#,##0.00;(#,##0.00)">
				<reportElement x="200" y="0" width="60" height="10"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{profitOrLoss}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="0" width="200" height="10"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="7"/>
				</textElement>
				<text><![CDATA[PERDIDAS / EXCEDENTES DEL PERIODO]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="27" width="200" height="12"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[TOTAL PASIVO + PATRIMONIO:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="10" width="200" height="12"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[TOTAL PATRIMONIO:]]></text>
			</staticText>
			<textField pattern="#,##0.00;(#,##0.00)">
				<reportElement x="200" y="10" width="60" height="12"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[($V{totalCreditBalance} != null ? $V{totalCreditBalance} : java.math.BigDecimal.ZERO).add($P{profitOrLoss} != null ? $P{profitOrLoss} : java.math.BigDecimal.ZERO)]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;(#,##0.00)">
				<reportElement x="200" y="27" width="60" height="12"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[($P{totalLiabilities} != null ? $P{totalLiabilities} : java.math.BigDecimal.ZERO).add(($V{totalCreditBalance} != null ? $V{totalCreditBalance} : java.math.BigDecimal.ZERO).add($P{profitOrLoss} != null ? $P{profitOrLoss} : java.math.BigDecimal.ZERO))]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
