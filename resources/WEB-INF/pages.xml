<?xml version="1.0" encoding="UTF-8"?>

<pages xmlns="http://jboss.com/products/seam/pages"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://jboss.com/products/seam/pages http://jboss.com/products/seam/pages-2.2.xsd"
       login-view-id="/login.xhtml">

    <page view-id="/home.xhtml" login-required="true">
        <end-conversation/>
        <navigation from-action="#{widgetAction.selectWidget(xmlId)}">
            <rule if-outcome="Success">
                <redirect view-id="/dashboard/widget.xhtml"/>
            </rule>
        </navigation>
    </page>

    <page view-id="/login.xhtml" action="#{authenticator.checkIfLoogedIn}" login-required="false">
        <navigation from-action="#{authenticator.checkIfLoogedIn}">
            <rule if="#{identity.loggedIn}">
                <redirect view-id="/home.xhtml"/>
            </rule>
        </navigation>

        <navigation from-action="#{identity.login}">
            <rule if="#{identity.loggedIn}">
                <redirect view-id="/home.xhtml"/>
            </rule>
        </navigation>
    </page>

    <page view-id="/admin/userSettings.xhtml" login-required="true">
        <navigation from-action="#{userSettingsAction.changePassword}">
            <rule if-outcome="Success">
                <redirect view-id="/home.xhtml"/>
            </rule>
        </navigation>
    </page>

    <page view-id="/admin/companySetting.xhtml" login-required="true">
        <end-conversation/>
        <!-- Al guardar se vuelve a la MISMA pantalla, no al home: es una pantalla de
             configuracion de ~123 campos en 7 tabs, y mandar al inicio obligaba a
             navegar de nuevo hasta aca por cada ajuste.
             Se usa <redirect> y no un simple REDISPLAY a proposito: el redirect da
             un limite de transaccion limpio y, combinado con el <end-conversation/>
             de arriba, hace que companySettingAction se recree y su @Create
             loadCompanySettings recargue la fila desde la base. Asi lo que queda en
             pantalla es lo que realmente se guardo, no el estado en memoria.
             Los FacesMessages de Seam sobreviven al redirect, asi que el aviso de
             "actualizado correctamente" se sigue viendo. -->
        <navigation from-action="#{companySettingAction.saveChanges}">
            <rule if-outcome="Success">
                <redirect view-id="/admin/companySetting.xhtml"/>
            </rule>
        </navigation>
    </page>

    <page view-id="*">
        <navigation from-action="#{identity.logout}">
            <redirect view-id="/login.xhtml"/>
        </navigation>
    </page>
    <page view-id="*" login-required="true">
        <begin-conversation flush-mode="MANUAL"/>
        <navigation from-action="#{companySettingAction.loadCompanySettings}">
            <rule if-outcome="Success">
                <redirect view-id="/admin/companySetting.xhtml"/>
            </rule>
        </navigation>
    </page>

    <exception class="org.jboss.seam.security.AuthorizationException">
        <end-conversation/>
        <redirect view-id="/error/accessDenied.xhtml">
            <message severity="error">#{messages['Security.accessDenied']}</message>
        </redirect>
    </exception>

    <exception>
        <end-conversation/>
        <redirect view-id="/error/exception.xhtml">
            <message severity="error">#{messages['Common.globalError.description']}</message>
        </redirect>
    </exception>

    <exception class="javax.faces.application.ViewExpiredException">
        <redirect view-id="/login.xhtml">
            <message>#{messages['org.jboss.seam.NotLoggedIn']}</message>
        </redirect>
    </exception>

    <exception class="com.encens.khipus.exception.finances.FinancesUserException">
        <end-conversation/>
        <redirect view-id="/error/exception.xhtml">
            <message severity="error">#{messages['WarehouseVoucher.error.invalidUser']}</message>
        </redirect>
    </exception>

    <exception class="com.encens.khipus.exception.admin.BusinessUnitAccessException">
        <end-conversation/>
        <redirect view-id="/error/exception.xhtml">
            <message severity="error">#{businessUnitAccessMessage.getMessage(org.jboss.seam.caughtException)}</message>
        </redirect>
    </exception>

    <!-- Cuenta contable de la tabla configuracion sin configurar (NULL o apuntando
         a una cuenta inexistente). El mensaje nombra la columna concreta que hay
         que cargar en Preferencias de compania; sin esto el usuario solo veia un
         NullPointerException o un EntityNotFoundException de un proxy de Hibernate. -->
    <exception class="com.encens.khipus.exception.finances.CompanyAccountNotConfiguredException">
        <end-conversation/>
        <redirect view-id="/error/exception.xhtml">
            <message severity="error">#{companyAccountNotConfiguredMessage.getMessage(org.jboss.seam.caughtException)}</message>
        </redirect>
    </exception>

</pages>
