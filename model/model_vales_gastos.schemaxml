<sql_create_table>CREATE TABLE `inv_destino` (
  `iddestino` bigint NOT NULL,
  `codigo` varchar(50) DEFAULT NULL,
  `nombre` varchar(255) DEFAULT NULL,
  `activo` int DEFAULT NULL,
  `tipo_area` varchar(100) DEFAULT NULL,
  `version` bigint DEFAULT NULL,
  `idcompania` bigint DEFAULT NULL,
  PRIMARY KEY (`iddestino`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3</sql_create_table>
</table>
<table name="detalleanalitica" view="colnames">
