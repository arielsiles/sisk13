<sql_create_table>CREATE TABLE `xpr_proceso` (
  `idproceso` bigint NOT NULL,
  `codigo` varchar(20) DEFAULT NULL,
  `posicion` int DEFAULT NULL,
  `nombre` varchar(255) NOT NULL,
  `estado` varchar(20) DEFAULT NULL,
  `idlinea` bigint DEFAULT NULL,
  `version` bigint DEFAULT NULL,
  `idcompania` bigint DEFAULT NULL,
  PRIMARY KEY (`idproceso`),
  UNIQUE KEY `codigo` (`codigo`),
  KEY `idlinea` (`idlinea`),
  CONSTRAINT `xpr_proceso_ibfk_1` FOREIGN KEY (`idlinea`) REFERENCES `xpr_linea` (`idlinea`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci</sql_create_table>
</table>
