<sql_create_table>CREATE TABLE `arcgms` (
  `cuenta` varchar(20) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin NOT NULL DEFAULT '',
  `descri` varchar(100) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `cta_raiz` varchar(20) DEFAULT NULL,
  `cta_niv3` varchar(20) DEFAULT NULL,
  `est` varchar(3) DEFAULT NULL,
  `cn_ana` varchar(1) DEFAULT NULL,
  `cn_nivel` int DEFAULT NULL,
  `cn_dv` int DEFAULT NULL,
  `cn_tip` varchar(1) DEFAULT NULL,
  `cn_act` int DEFAULT NULL,
  `no_cia` varchar(2) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `clase` varchar(1) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `tipo` varchar(2) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `tipo_gasto` varchar(50) DEFAULT NULL,
  `activa` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `util` varchar(2) DEFAULT NULL,
  `nomutil` varchar(50) DEFAULT NULL,
  `permite_iva` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `ind_presup` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `creditos` decimal(14,2) DEFAULT NULL,
  `moneda` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `debitos` decimal(14,2) DEFAULT NULL,
  `saldo_mes_ant_dol` decimal(20,6) DEFAULT NULL,
  `saldo_per_ant_dol` decimal(20,6) DEFAULT NULL,
  `creditos_dol` decimal(20,6) DEFAULT NULL,
  `debitos_dol` decimal(20,6) DEFAULT NULL,
  `gru_cta` varchar(6) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `permiso_con` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `exije_cc` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `permiso_afijo` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `permiso_cxp` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `permiso_cxc` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `permiso_che` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `permiso_inv` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `f_inactiva` date DEFAULT NULL,
  `ind_mov` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `saldo_mes_ant` decimal(15,2) DEFAULT NULL,
  `saldo_per_ant` decimal(15,2) DEFAULT NULL,
  PRIMARY KEY (`cuenta`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3</sql_create_table>
</table>
