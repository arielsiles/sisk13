<table name="inv_almacenes" view="colnames">
<left>170</left>
<top>87</top>
<width>210</width>
<height>276</height>
<sql_create_table>CREATE TABLE `inv_almacenes` (
  `no_cia` varchar(2) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin NOT NULL,
  `cod_alm` varchar(6) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin NOT NULL,
  `cuenta` varchar(20) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `ctacosto` varchar(20) DEFAULT NULL,
  `descri` varchar(100) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `tipo` varchar(20) DEFAULT NULL,
  `id_responsable` bigint DEFAULT NULL,
  `estado` varchar(3) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `version` bigint DEFAULT NULL,
  `cod_est` varchar(15) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `idunidadnegocio` bigint DEFAULT NULL,
  `inv_egr` int DEFAULT NULL,
  PRIMARY KEY (`no_cia`,`cod_alm`),
  KEY `id_responsable` (`id_responsable`),
  CONSTRAINT `inv_almacenes_ibfk_1` FOREIGN KEY (`id_responsable`) REFERENCES `empleado` (`idempleado`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3</sql_create_table>
</table>
<table name="inv_vales" view="colnames">
<left>554</left>
<top>89</top>
<width>218</width>
<height>271</height>
<sql_create_table>CREATE TABLE `inv_vales` (
  `no_cia` varchar(2) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `no_trans` varchar(10) NOT NULL,
  `contracuenta` varchar(20) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `cod_cc` varchar(8) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `fecha` date DEFAULT NULL,
  `cod_doc` varchar(3) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `no_vale` varchar(20) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `id_com_encoc` bigint DEFAULT NULL,
  `no_trans_rec` varchar(10) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `estado` varchar(3) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `cta_gasto` varchar(20) DEFAULT NULL,
  `fechacreacion` timestamp NULL DEFAULT CURRENT_TIMESTAMP,
  `tipo_gasto` varchar(100) DEFAULT NULL,
  `oper` varchar(6) DEFAULT NULL,
  `dest` varchar(10) DEFAULT NULL,
  `orig` varchar(10) DEFAULT NULL,
  `dest_cod_cc` varchar(8) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `cod_alm_dest` varchar(6) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `version` bigint DEFAULT NULL,
  `cod_alm` varchar(6) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `tiporecepcion` varchar(2) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `idunidadnegocio` bigint DEFAULT NULL,
  `no_cia_raiz` varchar(2) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin DEFAULT NULL,
  `no_trans_raiz` varchar(10) DEFAULT NULL,
  `idcontratopuestosol` bigint DEFAULT NULL,
  `id_responsable` bigint DEFAULT NULL,
  `idunidadnegocio_dest` bigint DEFAULT NULL,
  `id_responsable_dest` bigint DEFAULT NULL,
  `idordenproduccion` bigint DEFAULT NULL,
  `idproductobase` bigint DEFAULT NULL,
  `idtmpenc` bigint DEFAULT NULL,
  `idpedidostr` bigint DEFAULT NULL,
  `iddestino` bigint DEFAULT NULL,
  UNIQUE KEY `no_trans_UNIQUE` (`no_trans`),
  KEY `id_com_encoc` (`id_com_encoc`),
  KEY `idtmpenc` (`idtmpenc`),
  KEY `idpedidostr` (`idpedidostr`),
  KEY `iddestino` (`iddestino`),
  CONSTRAINT `inv_vales_ibfk_1` FOREIGN KEY (`id_com_encoc`) REFERENCES `com_encoc` (`id_com_encoc`),
  CONSTRAINT `inv_vales_ibfk_2` FOREIGN KEY (`idtmpenc`) REFERENCES `sf_tmpenc` (`id_tmpenc`),
  CONSTRAINT `inv_vales_ibfk_3` FOREIGN KEY (`idpedidostr`) REFERENCES `pedidos` (`IDPEDIDOS`),
  CONSTRAINT `inv_vales_ibfk_4` FOREIGN KEY (`iddestino`) REFERENCES `inv_destino` (`iddestino`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3</sql_create_table>
</table>
