{
  "config": {
    "archivo_por_defecto": "plan_ctas/plan_cuentas.xlsx",
    "directorio_reportes": "scripts/reportes/",
    "formato_timestamp": "%Y%m%d_%H%M%S",
    "max_errores_mostrar": 20,
    "encoding_reporte": "utf-8"
  },
  "estructura_niveles": {
    "nivel_1": {
      "patron": "X000000000",
      "descripcion": "1 dígito + 9 ceros",
      "ejemplo": "1000000000"
    },
    "nivel_2": {
      "patron": "XX00000000", 
      "descripcion": "2 dígitos + 8 ceros",
      "ejemplo": "1100000000"
    },
    "nivel_3": {
      "patron": "XXX0000000",
      "descripcion": "3 dígitos + 7 ceros", 
      "ejemplo": "1110000000"
    },
    "nivel_4": {
      "patron": "XXXXXX0000",
      "descripcion": "6 dígitos + 4 ceros",
      "ejemplo": "1110010000"
    },
    "nivel_5": {
      "patron": "XXXXXXXX00",
      "descripcion": "8 dígitos + 2 ceros",
      "ejemplo": "1110010100"
    },
    "nivel_6": {
      "patron": "XXXXXXXXXX",
      "descripcion": "10 dígitos completos",
      "ejemplo": "1110040101"
    }
  },
  "validaciones": {
    "columnas_requeridas": ["cuenta", "cn_nivel"],
    "columnas_opcionales": ["descri"],
    "longitud_cuenta": 10,
    "niveles_validos": [1, 2, 3, 4, 5, 6]
  },
  "notificaciones": {
    "email_habilitado": false,
    "email_destinatarios": [],
    "email_servidor": "",
    "solo_enviar_si_errores": true
  },
  "automatizacion": {
    "crear_backup_antes_validar": false,
    "backup_directorio": "backups/",
    "limpiar_reportes_antiguos": true,
    "dias_conservar_reportes": 30
  }
}