# Plantilla de configuracion de produccion POR CLIENTE.
#
# Para agregar un cliente:
#   1. Copiar este archivo como build-prod-<cliente>.properties  (ej.: build-prod-ilva.properties)
#   2. Completar las propiedades de abajo
#   3. Construir con:  ant -f build-prod.xml -Dclient=<cliente> dist-release
#
# El schema se inyecta en Constants.java solo durante la compilacion; el fuente
# se restaura automaticamente al terminar (el working tree de git queda limpio).

# Schema MySQL del cliente (valor unico para KHIPUS/FINANCES/CASHBOX/ACADEMIC_SCHEMA)
dbSchema=

# Subcarpeta del cliente dentro de release.dir (D:/appserver/release/<clientReleaseName>/v<version>)
clientReleaseName=

# Compania que aparece pre-llenada en el login (solo la compania; usuario/contrasena nunca)
clientCompanyLogin=

# Skin RichFaces del cliente (se inyecta en web.xml al compilar). Conocidos: DEFAULT, glassX, darkX
richfacesSkin=
